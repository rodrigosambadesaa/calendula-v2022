<resources>


    <style name="AppTheme" parent="MaterialDrawerTheme.Light.TranslucentStatus">
        <!-- Set AppCompat’s actionBarStyle -->
        <!--<item name="actionBarStyle">@style/MyActionBar</item>-->
        <!--<item name="windowActionBar">false</item>-->
        <!-- Set AppCompat’s color theming attrs -->
        <item name="colorPrimary">@color/android_blue_dark</item>
        <item name="colorPrimaryDark">@color/transparent</item>
        <item name="android:statusBarColor">@color/android_blue_statusbar</item>
        <item name="android:windowAllowReturnTransitionOverlap">false</item>
        <!--<item name="android:windowDrawsSystemBarBackgrounds">true</item>-->
        <!--<item name="windowActionModeOverlay">true</item>-->
        <!-- The rest of your attributes -->
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="siv_insetForeground">#01ffffff</item>
    </style>

    <!-- Styles for pop-up dialogs -->
    <style name="AppTheme.DialogTheme" parent="Theme.AppCompat.Light.Dialog">

        <item name="colorPrimary">@color/android_blue</item>
        <item name="colorPrimaryDark">@color/android_blue_dark</item>
        <item name="colorAccent">@color/android_blue_darker</item>

    </style>

    <style name="Theme.ModalIntro" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@color/android_blue_darker</item>
    </style>

    <style name="BlueProgressBar" parent="Theme.AppCompat.Light">
        <item name="colorAccent">@color/android_blue</item>
    </style>

    <!-- just defines top layer "Animation" -->

    <!-- the animations must have been defined in your "anim" folder, of course -->
    <style name="Animation.Splash" parent="android:style/Animation.Activity">
        <item name="android:windowEnterAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_in_from_bottom</item>
    </style>

    <style name="SplashTheme" parent="MaterialDrawerTheme.Light.TranslucentStatus">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowAnimationStyle">@style/Animation.Splash</item>
        <item name="md_positive_color">@color/md_pink_600</item>
    </style>


    <style name="DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">@android:color/white</item>
    </style>


    


    <style name="next_button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:height">@dimen/normal_button_height</item>
        <item name="android:background">@color/android_blue_dark</item>
    </style>


    <style name="delay_button">
        <item name="android:textColor">@color/dark_grey_home</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:height">@dimen/normal_button_height</item>
        <item name="android:background">@drawable/delay_button_selector</item>
    </style>

    


    

    

    <style name="schedule_weekday_unselected">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">@color/activity_schedule_build_foreground_alpha</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="schedule_weekday_selected">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="whiteTextWithShadow">
        <item name="android:textColor">#ffffffff</item>
        <item name="android:shadowColor">#55111111</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <style name="BetterPickersDialogFragment.Calendula">
        <item name="bpDialogBackground">@drawable/dialog_full_holo_light</item>
        <item name="bpTitleColor">@color/dialog_text_color_holo_light</item>
        <item name="bpTextColor">@color/android_blue_darker</item>
        <item name="bpDeleteIcon">@drawable/ic_backspace_light</item>
        <item name="bpCheckIcon">@drawable/ic_check_light</item>
        <item name="bpKeyBackground">@drawable/key_background_light</item>
        <item name="bpButtonBackground">@drawable/button_background_light</item>
        <item name="bpTitleDividerColor">@color/default_keyboard_indicator_color_dark</item>
        <item name="bpDividerColor">@color/default_divider_color_light</item>
        <item name="bpKeyboardIndicatorColor">@color/default_keyboard_indicator_color_light</item>
    </style>

    

    

    

    

    <style name="menu_labels_style">
        <item name="android:background">@drawable/fab_label_background</item>
        <item name="android:textColor">@color/white</item>
    </style>


    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>

    

    <style name="ToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">#ffffff</item>
    </style>

    

    <!--<style >-->
    <!--<item name="android:textColor">@color/white</item>-->
    <!--<item name="android:textStyle">bold</item>-->
    <!--<item name="android:textSize">15dp</item>-->
    <!--<item name="android:height">@dimen/normal_button_height</item>-->
    <!--<item name="android:background">@color/transparent</item>-->
    <!--</style>-->


    <!-- Calendar -->

    <style name="CaldroidDefaultNoGrid" parent="CaldroidDefault">
        <item name="styleCaldroidGridView">@style/CaldroidDefaultDarkGridView</item>
    </style>

    <style name="CaldroidDefaultDarkGridView" parent="CaldroidDefaultGridView">
        <item name="android:background">@color/transparent</item>
    </style>

    


    


    <!-- Summary calendar theme -->
    <!-- Dark theme. -->
    <style name="CaldroidScheduleSummary" parent="CaldroidDefault">
        <item name="styleCaldroidViewLayout">@style/CaldroidScheduleSummaryCalendarViewLayout</item>
        <item name="styleCaldroidMonthName">@style/CaldroidScheduleSummaryMonthName</item>
        <item name="styleCaldroidNormalCell">@style/CaldroidScheduleSummaryNormalCell</item>
        <item name="styleCaldroidSquareCell">@style/CaldroidScheduleSummarySquareCell</item>
        <item name="styleCaldroidGridView">@style/CaldroidScheduleSummaryGridView</item>
        <item name="styleCaldroidLeftArrow">@style/CaldroidScheduleSummaryLeftButton</item>
        <item name="styleCaldroidRightArrow">@style/CaldroidScheduleSummaryRightButton</item>

    </style>

    <style name="CaldroidScheduleSummaryArrowButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
    </style>

    <style name="CaldroidScheduleSummaryLeftButton" parent="CaldroidScheduleSummaryArrowButton">
        <item name="android:layout_alignParentLeft">true</item>
    </style>

    <style name="CaldroidScheduleSummaryRightButton" parent="CaldroidScheduleSummaryArrowButton">
        <item name="android:layout_alignParentRight">true</item>
    </style>

    <style name="CaldroidScheduleSummaryCalendarViewLayout">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="CaldroidScheduleSummaryMonthName" parent="CaldroidDefaultMonthName">
        <item name="android:textColor">@color/activity_schedule_build_foreground</item>
        <item name="android:height">50dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="CaldroidScheduleSummaryGridView" parent="CaldroidDefaultGridView">
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="CaldroidScheduleSummaryCell" parent="CaldroidDefaultCell">
        <item name="android:textColor">@color/activity_schedule_build_foreground_50</item>
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="CaldroidScheduleSummaryNormalCell" parent="CaldroidScheduleSummaryCell">
        <item name="android:padding">5dp</item>
    </style>

    <style name="CaldroidScheduleSummarySquareCell" parent="CaldroidScheduleSummaryCell"/>


    <!-- Summary calendar theme -->
    <!-- Dark theme. -->
    <style name="CaldroidPickups" parent="CaldroidDefault">
        <item name="styleCaldroidViewLayout">@style/CaldroidPickupsCalendarViewLayout</item>
        <item name="styleCaldroidMonthName">@style/CaldroidPickupsMonthName</item>
        <item name="styleCaldroidNormalCell">@style/CaldroidPickupsNormalCell</item>
        <item name="styleCaldroidSquareCell">@style/CaldroidPickupsSquareCell</item>
        <item name="styleCaldroidGridView">@style/CaldroidPickupsGridView</item>
    </style>

    <style name="CaldroidPickupsCalendarViewLayout">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="CaldroidPickupsMonthName" parent="CaldroidDefaultMonthName">
        <item name="android:textColor">#222</item>
    </style>

    <style name="CaldroidPickupsGridView" parent="CaldroidDefaultGridView">
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="CaldroidPickupsCell" parent="CaldroidDefaultCell">
        <item name="android:textColor">@color/white_80</item>
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="CaldroidPickupsNormalCell" parent="CaldroidPickupsCell">
        <item name="android:padding">5dp</item>
    </style>

    <style name="CaldroidPickupsSquareCell" parent="CaldroidPickupsCell">
        <item name="android:padding">5dp</item>
    </style>

    <style name="KeypadButtonStyle" parent="@style/Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_margin">1dp</item>
        <item name="background">@color/white_20</item>
    </style>

    

    <style name="SettingsActivityTheme" parent="AppTheme">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="background">@color/android_red</item>
    </style>

</resources>
