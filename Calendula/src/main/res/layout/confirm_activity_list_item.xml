<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                xmlns:tools="http://schemas.android.com/tools"
                android:background="@color/transparent"
                android:paddingLeft="10dp">


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="50dp"
        android:layout_height="60dp"
        android:layout_centerVertical="false"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="2dp"
        android:layout_marginTop="10dp"
        android:cropToPadding="false"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:visibility="visible"/>


    <TextView
        android:id="@+id/med_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="10dp"
        android:layout_toRightOf="@+id/imageView"
        android:fontFamily="sans-serif-light"
        android:gravity="center_vertical"
        android:paddingBottom="3dp"
        android:textColor="#222"
        android:textSize="16dp"
        android:textStyle="bold"
        tools:text="Ibuprofeno"/>


    <TextView
        android:id="@+id/med_item_dose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_alignLeft="@+id/med_item_name"
        android:layout_below="@+id/med_item_name"
        android:alpha="0.7"
        android:fontFamily="sans-serif-condensed"
        android:gravity="top"
        tools:text="1 capsule"
        android:textColor="#111"
        android:textSize="17dp"/>

    <TextView
        android:id="@+id/med_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/med_item_dose"
        android:layout_below="@+id/med_item_dose"
        android:layout_marginTop="3dp"
        android:alpha="0.7"
        android:fontFamily="sans-serif-light"
        android:gravity="top"
        tools:text="Not taken yet"
        android:textColor="#555"
        android:textSize="13dp"/>

    <TextView
        android:id="@+id/med_item_offset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/med_item_dose"
        android:layout_below="@+id/med_item_status"
        android:layout_marginTop="15dp"
        android:layout_marginRight="40dp"
        android:alpha="1"
        android:fontFamily="sans-serif-light"
        android:gravity="top"
        android:textColor="#222"
        android:textSize="14dp"
        android:textStyle="bold"
        tools:text="Instrucciones: Consulte a su farmacéutico en caso de duda"/>


    <TextView
        android:id="@+id/med_item_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/med_item_dose"
        android:layout_below="@+id/med_item_offset"
        android:layout_marginTop="10dp"
        android:layout_marginRight="26dp"
        android:alpha="1"
        android:fontFamily="sans-serif-light"
        android:gravity="top"
        tools:text="Después de la cena"
        android:textColor="#222"
        android:textStyle="bold"
        android:textSize="14dp"/>


    <TextView
        android:id="@+id/med_item_alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/med_item_dose"
        android:layout_below="@+id/med_item_info"
        android:layout_marginRight="40dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-light"
        android:gravity="top"
        android:text="@string/confirm_activity_reminder_differs_from_official"
        android:textColor="#222"
        android:textSize="14dp"
        android:textStyle="bold"
        android:visibility="visible"/>

    <ImageButton
        android:id="@+id/check_button"
        style="@style/Base.Widget.AppCompat.Button.Borderless"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/med_item_name"
        android:layout_marginRight="16dp"
        android:src="@drawable/ic_done_black_48dp"
        android:visibility="visible"/>

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="fill_parent"
        android:layout_height="1px"
        android:layout_alignLeft="@+id/med_item_status"
        android:layout_alignParentBottom="false"
        android:layout_below="@+id/med_item_alert"
        android:layout_marginTop="16dp"
        android:background="#ececec"/>

</RelativeLayout>
