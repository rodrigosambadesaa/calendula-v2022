<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:paddingTop="10dp">

        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignEnd="@+id/selection_mask"
            android:layout_alignLeft="@+id/selection_mask"
            android:layout_alignParentTop="false"
            android:layout_alignRight="@+id/selection_mask"
            android:layout_alignStart="@+id/selection_mask"
            android:layout_centerVertical="true"
            android:background="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/medicines_list_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="16dp"
            android:layout_toEndOf="@+id/imageButton"
            android:layout_toLeftOf="@+id/selection_indicator"
            android:layout_toRightOf="@+id/imageButton"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:gravity="center_vertical"
            android:paddingRight="6dp"
            android:singleLine="false"
            android:textColor="#111"
            android:textSize="15sp"
            tools:text="Placeholder medicine that can have a pretty long name"/>

        <ImageView
            android:id="@+id/selection_indicator"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            />

</RelativeLayout>
