<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:addStatesFromChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- No unverified medicine name, dose, time or patient identity here.
             One generic, accessible warning for the selected patient only. -->
        <TextView
            android:id="@+id/agenda_medication_review_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFF3CD"
            android:textColor="#4A3000"
            android:text="@string/agenda_medication_review_warning"
            android:importantForAccessibility="yes"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="fill_vertical"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/empty_view_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <include layout="@layout/daily_view_empty_placeholder" />
    </FrameLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/transparent_black_overlay_transition"
        android:padding="15dp"
        android:visibility="invisible">

        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@drawable/reminder_view_bg"
            android:padding="10dp"
            android:visibility="visible">

            <FrameLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:background="@drawable/shape_list_item"
                android:visibility="invisible">

                <include
                    layout="@layout/activity_agenda_zoom"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />

            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

</RelativeLayout>
