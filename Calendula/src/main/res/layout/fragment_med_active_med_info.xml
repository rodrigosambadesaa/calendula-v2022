<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                                            xmlns:app="http://schemas.android.com/apk/res-auto"
                                            xmlns:tools="http://schemas.android.com/tools"
                                            android:id="@+id/nestedScrollView"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:background="#fff"
                                            android:fillViewport="true"
                                            android:fitsSystemWindows="true"
                                            android:paddingTop="10dp"
                                            app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingRight="16dp">


            <!-- TODO delete? What to do with this? -->
            <RelativeLayout
                android:id="@+id/treatment_type_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ic_treatment_type"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="16dp"
                    android:src="@drawable/ic_edit_black_48dp"
                    app:iiv_icon="gmd-assignment"
                    app:iiv_padding="4dp"
                    />

                <TextView
                    android:id="@+id/treatment_type_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginLeft="72dp"
                    android:layout_toRightOf="@+id/ic_treatment_type"
                    android:gravity="center_vertical"
                    android:textAllCaps="false"
                    android:textColor="#000"
                    android:textIsSelectable="false"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="@string/title_long_term_treatment"/>

                <TextView
                    android:id="@+id/treatment_type_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="false"
                    android:layout_below="@+id/treatment_type_title"
                    android:layout_marginLeft="72dp"
                    android:layout_toRightOf="@+id/ic_treatment_type"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:textColor="@color/dark_grey_text"
                    android:textSize="18sp"
                    tools:text="@string/text_long_term_treatment"/>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/schedule_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp">

                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ic_active_med_schedule"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="16dp"
                    android:src="@drawable/ic_edit_black_48dp"
                    app:iiv_icon="gmd-calendar"
                    app:iiv_padding="4dp"
                    />

                <TextView
                    android:id="@+id/active_med_schedule_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginLeft="72dp"
                    android:layout_toRightOf="@+id/ic_active_med_schedule"
                    android:gravity="center_vertical"
                    android:text="@string/title_active_med_schedule_info"
                    android:textAllCaps="false"
                    android:textColor="#000"
                    android:textIsSelectable="false"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/schedule_info_date_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_below="@+id/active_med_schedule_title"
                    android:layout_marginLeft="72dp"
                    android:layout_toRightOf="@id/ic_active_med_schedule"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/active_med_from_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_med_from"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/schedule_info_date_from"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:layout_marginStart="6dp"
                            android:textSize="17sp"
                            tools:text="16/01/16"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/active_med_to_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_med_to"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/schedule_info_date_to"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:layout_marginStart="6dp"
                            android:textSize="17sp"
                            tools:text="22/2/16"/>
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/active_med_schedule_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="false"
                    android:layout_below="@+id/schedule_info_date_layout"
                    android:layout_marginLeft="72dp"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="8dp"
                    android:layout_toEndOf="@+id/ic_active_med_schedule"
                    android:layout_toRightOf="@+id/ic_active_med_schedule"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:textColor="@color/dark_grey_text"
                    android:textSize="18sp"
                    tools:text="Take 2 every 48 hours.\nRecommended intakes:\n\t* 1 with breakfast\n\t* 1/2 with lunch\n\t* 1/2 with dinner"/>


                <TextView
                    android:id="@+id/active_med_intake_instructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="false"
                    android:layout_below="@id/active_med_schedule_text"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginTop="8dp"
                    android:layout_toEndOf="@id/ic_active_med_schedule"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:textColor="@color/dark_grey_text"
                    android:textSize="18sp"
                    tools:text="Instruction provided by the practitioner.\nRecommended actions:\n\t* Do not drink alcohol\n\t"/>

                <Button
                    android:id="@+id/enable_reminders_button"
                    android:textColor="@color/android_green"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="72dp"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="0dp"
                    android:layout_height="40dp"
                    android:layout_below="@id/active_med_intake_instructions"
                    android:gravity="center_vertical"
                    tools:text="Reminders are enabled"
                    android:drawableRight="@drawable/ic_arrow_back_black_48dp"
                    android:padding="5dp"
                    android:src="@null"/>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/substitution_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ic_substitution"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="16dp"
                    android:src="@drawable/ic_edit_black_48dp"
                    app:iiv_icon="gmd-repeat"
                    app:iiv_padding="4dp"
                    />

                <TextView
                    android:id="@+id/substitution_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginLeft="72dp"
                    android:layout_toRightOf="@+id/ic_substitution"
                    android:gravity="center_vertical"
                    android:text="@string/title_substitution_info"
                    android:textAllCaps="false"
                    android:textColor="#000"
                    android:textIsSelectable="false"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <!-- TODO don't hardcode this text, generate in fragment from med info-->
                <TextView
                    android:id="@+id/substitution_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="false"
                    android:layout_below="@+id/substitution_title"
                    android:layout_marginLeft="72dp"
                    android:layout_toRightOf="@+id/ic_substitution"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:text="This medicine substitutes the prescribed medicine with name: PLACEHOLDER MEDICINE 1"
                    android:textColor="@color/dark_grey_text"
                    android:textSize="18sp"/>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/dispensation_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:visibility="visible"
                tools:visibility="visible">

                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ic_dispensation"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="16dp"
                    android:src="@drawable/ic_edit_black_48dp"
                    app:iiv_icon="cmd-calendar-check"
                    app:iiv_padding="4dp"
                    />

                <TextView
                    android:id="@+id/dispensation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginLeft="72dp"
                    android:layout_toRightOf="@+id/ic_dispensation"
                    android:gravity="center_vertical"
                    android:text="@string/title_dispensation_info"
                    android:textAllCaps="false"
                    android:textColor="#000"
                    android:textIsSelectable="false"
                    android:textSize="19sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/dispensation_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="false"
                    android:layout_below="@+id/dispensation_title"
                    android:layout_marginLeft="72dp"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="8dp"
                    android:layout_toEndOf="@+id/ic_dispensation"
                    android:layout_toRightOf="@+id/ic_dispensation"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:textColor="@color/dark_grey_text"
                    android:textSize="16sp"
                    tools:text="Last: 20/08\nNext: 20/08"/>


                <TextView
                    android:id="@+id/dispensation_interval_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="false"
                    android:layout_below="@+id/dispensation_text"
                    android:layout_marginLeft="72dp"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="8dp"
                    android:layout_toEndOf="@+id/ic_dispensation"
                    android:layout_toRightOf="@+id/ic_dispensation"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:textColor="@color/android_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="@string/dispensation_interval_open"/>

                <FrameLayout
                    android:id="@+id/dispensation_calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="false"
                    android:layout_below="@+id/dispensation_interval_info"
                    android:layout_marginLeft="26dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="16dp"
                    android:layout_toRightOf="@+id/ic_dispensation"/>

            </RelativeLayout>


        </LinearLayout>

    </RelativeLayout>


</androidx.core.widget.NestedScrollView>


